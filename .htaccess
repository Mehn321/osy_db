<FilesMatch "\.(txt|log|sql|ini|example\.php|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect setup and debug scripts
<FilesMatch "^(CSRF_DIAGNOSTIC\.php|FEATURE_TEST_RUNNER\.php|TEST_SUITE\.php|create_db\.php|create_matches_table\.php|migrate.*\.php|run_mig\.php|run_migrations\.php|seed_.*\.php|send_sms_.*\.php|setup_.*\.php|sms_.*\.php|test-.*\.html|test_.*\.php|check_tables\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory listing
Options -Indexes
